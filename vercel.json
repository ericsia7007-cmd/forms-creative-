{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "forms-creative.vercel.app" }],
      "destination": "https://www.formscreativestudio.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "forms-creative.vercel.app" }],
      "destination": "https://www.formscreativestudio.com/:path+",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/weddings/:slug", "destination": "/index.html" }]
}
